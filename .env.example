# ============================================
# LaunchLoop AI — Environment Variables
# ============================================

# ---- DATABASE (Required) ----
# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/launchloop?sslmode=require

# ---- AI PROVIDER (Required for real mode) ----
# OpenAI-compatible API key
OPENAI_API_KEY=sk-your-key-here

# API base URL (default: OpenAI). Change for other providers.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4o-mini)
AI_MODEL=gpt-5-nano

# ---- GITHUB (Optional but recommended) ----
# GitHub personal access token for higher API rate limits
GITHUB_TOKEN=

# ---- DEPLOYMENT ----
# Production URL for QR codes and share links
NEXT_PUBLIC_APP_URL=https://applybee.vercel.app

# Signs the anonymous project-ownership cookie. Any random 32+ char string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset = ownership disabled and every project stays unclaimed.
OWNER_SECRET=your_random_secret_here

# ---- FREE TIER (Optional) ----
# How many experiments a caller gets before the product asks for something.
# Counted per address (stored only as an HMAC), enforced in src/lib/quota.ts.
QUOTA_FREE_WEEK=1
QUOTA_FREE_MONTH=4
QUOTA_SIGNED_MONTH=8

# Set to 1 to lift the free tier entirely. A venue puts a whole room behind
# one address, so a limit that is right in production can be wrong on stage.
QUOTA_DISABLED=
