# ============================================
# LaunchLoop AI — Environment Variables
# ============================================

# ---- DATABASE (Required) ----
# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/launchloop?sslmode=require

# ---- AI PROVIDER (Required for real mode) ----
# OpenAI-compatible API key
OPENAI_API_KEY=sk-your-key-here

# API base URL (default: OpenAI). Change for other providers.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4o-mini)
AI_MODEL=gpt-5-nano

# ---- GITHUB (Optional but recommended) ----
# GitHub personal access token for higher API rate limits
GITHUB_TOKEN=

# ---- DEPLOYMENT ----
# Production URL for QR codes and share links
NEXT_PUBLIC_APP_URL=https://applybee.vercel.app

# Signs the anonymous project-ownership cookie. Any random 32+ char string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset = ownership disabled and every project stays unclaimed.
OWNER_SECRET=your_random_secret_here

# ---- AUTH (accounts + referral claims) ----
# Signs the session cookie for sign-ins. Any random 32+ char string.
# If unset, OWNER_SECRET is used as a fallback. Neither set = sign-in disabled.
AUTH_SECRET=another_random_secret_here

# Magic-link email provider (Resend). Without this, the link is only shown on
# non-production deployments so the flow can be demoed locally.
# Get a key at https://resend.com — the free tier is enough for a hackathon.
RESEND_API_KEY=

# From address for magic-link emails.
EMAIL_FROM=LaunchLoop AI <onboarding@resend.dev>
